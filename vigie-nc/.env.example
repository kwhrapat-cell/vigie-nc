# Copier en .env.local et remplir avec les valeurs du projet Supabase
# (Project Settings > API dans le dashboard Supabase)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Notifications (facultatif) : paire de clés VAPID (npx web-push generate-vapid-keys)
# et secret partagé avec la base (table vigie_config, clé notif_secret).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NOTIF_SECRET=

# Résumé automatique des témoignages (facultatif) : clé de l'API Claude
# (console.anthropic.com > API Keys). Sans elle, aucun résumé n'est écrit.
ANTHROPIC_API_KEY=
